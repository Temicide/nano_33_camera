{
  "arduino.path": "/opt/homebrew/bin",
  "arduino.commandPath": "arduino-cli",
  "arduino.useArduinoCli": true,
  "arduino.allowPDEextname": true,
  "arduino.enableUSBDetection": true,
  "arduino.logLevel": "info",
  "arduino.defaultBaudRate": 115200,
  "arduino.fqbn": "arduino:mbed_nano:nano33ble",
  // Port changes after upload/reset — run: ./scripts/port.sh
  "arduino.port": "/dev/cu.usbmodem14301",
  "arduino.sketchbook.path": "${workspaceFolder}",
  "files.associations": {
    "*.ino": "cpp"
  },
  "C_Cpp.default.configurationProvider": "vscode-arduino.vscode-arduino-community",
  "C_Cpp.intelliSenseEngine": "default",
  "clangd.enable": false
}
