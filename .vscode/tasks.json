{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: Compile",
      "type": "shell",
      "command": "arduino-cli compile --fqbn ${config:arduino.fqbn} ${workspaceFolder}/nano_33",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload",
      "type": "shell",
      "command": "arduino-cli upload -p ${config:arduino.port} --fqbn ${config:arduino.fqbn} ${workspaceFolder}/nano_33",
      "dependsOn": "Arduino: Compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Arduino: Serial Monitor",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/monitor.sh",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Arduino: List boards / ports",
      "type": "shell",
      "command": "arduino-cli board list",
      "problemMatcher": []
    }
  ]
}
